<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================== -->
    <!-- 1. TRANG CHỦ                                   -->
    <!-- ============================================== -->
    <template id="website.homepage" name="Homepage">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'homepage'"/>
            <div id="wrap" class="oe_structure">

                <!-- Section 1: Banner -->
                <section class="s_cover parallax s_parallax_is_fixed o_cc o_cc5 o_colored_level pt256 pb112" data-scroll-background-ratio="1" data-snippet="s_cover" style="background-color: rgb(248, 249, 250);">
                    <!-- Ảnh Banner -->
                    <span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" 
                          style="background-image: url('/ht_beauty_website/static/img/banner_home.jpg');"/>
                    <div class="o_we_bg_filter bg-black-50"/>
                    <div class="s_allow_columns container">
                        <div class="row">
                            <div class="o_colored_level col-lg-12 pb0 pt0">
                                <h1 style="text-align: center;" class="display-4 text-white">
                                    <strong>Phòng khám Chuyên khoa Da liễu HT Beauty</strong>
                                </h1>
                                <p class="lead text-white" style="text-align: center;">
                                    Đánh thức vẻ đẹp tiềm ẩn - Thăng hoa nhan sắc Việt
                                </p>
                                <p style="text-align: center;">
                                    <a class="mb-2 btn btn-light" href="/dich-vu">Khám phá dịch vụ</a> 
                                    <a class="mb-2 btn btn-outline-light" href="/lien-he">Tư vấn miễn phí</a>
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Section 2: Trải nghiệm -->
                <section class="s_text_image pt80 pb80 o_colored_level" data-snippet="s_text_image" style="background-color: rgb(248, 249, 250);">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="pt16 pb16 o_colored_level col-lg-5">
                                <h2 class="h3-fs">Trải Nghiệm Làm Đẹp<strong> Chuẩn Y Khoa</strong></h2>
                                <p>Mỗi làn da đều kể một câu chuyện riêng. Chúng tôi tự hào mang đến các giải pháp chăm sóc và điều trị chuyên sâu, được thiết kế riêng biệt cho từng tình trạng da của bạn. Sự tự tin và rạng rỡ của bạn là minh chứng rõ ràng nhất cho chất lượng dịch vụ của chúng tôi.</p>
                                <p><a href="/dich-vu" class="btn" style="background-color: #bbf7d0; color: #0d47a1;">Khám Phá Dịch Vụ</a></p>
                            </div>
                            <div class="pt16 pb16 o_colored_level offset-lg-1 col-lg-6">
                                <!-- Ảnh Trải Nghiệm -->
                                <img src="/ht_beauty_website/static/img/trai_nghiem.jpg" alt="Trải nghiệm" class="img img-fluid mx-auto rounded" loading="lazy"/>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Section 3: 4 Dịch vụ chính -->
                <section class="s_key_images pt72 o_colored_level pb80" data-snippet="s_key_images" style="background-color: rgb(248, 249, 250);">
                    <div class="container">
                        <h2><strong>Những dịch vụ thẩm mỹ và chăm sóc sắc đẹp hàng đầu</strong></h2>
                        <p class="lead">Nổi bật với các liệu trình điều trị <b>Nám – Mụn – Thâm – Viêm nang lông</b>, cùng các giải pháp trẻ hóa và làm sáng da toàn diện. HT Beauty ứng dụng các công nghệ tiên tiến kết hợp cùng quy trình y khoa chuẩn mực đảm bảo tiêu chuẩn an toàn và chất lượng cao.</p>
                        <p><br/></p>
                        <div class="row">
                            <div class="col-6 col-lg-3 o_colored_level">
                                <p class="h1-fs" style="color: #1a202c;">01</p>
                                <!-- Ảnh Dịch Vụ 01 -->
                                <p><img src="/ht_beauty_website/static/img/service_01.jpg" alt="Nâng cơ" class="img img-fluid rounded" style="width: 100%; aspect-ratio: 1/1; object-fit: cover;" loading="lazy"/></p>
                                <p class="font-weight-bold">Nâng cơ - Trẻ hóa da</p>
                            </div>
                            <div class="col-6 col-lg-3 o_colored_level">
                                <p class="h1-fs" style="color: #1a202c;">02</p>
                                <!-- Ảnh Dịch Vụ 02 -->
                                <p><img src="/ht_beauty_website/static/img/service_02.jpg" alt="Chăm sóc" class="img img-fluid rounded" style="width: 100%; aspect-ratio: 1/1; object-fit: cover;" loading="lazy"/></p>
                                <p class="font-weight-bold">Chăm sóc - Phục hồi da</p>
                            </div>
                            <div class="col-6 col-lg-3 o_colored_level">
                                <p class="h1-fs" style="color: #1a202c;">03</p>
                                <!-- Ảnh Dịch Vụ 03 -->
                                <p><img src="/ht_beauty_website/static/img/service_03.jpg" alt="Điều trị" class="img img-fluid rounded" style="width: 100%; aspect-ratio: 1/1; object-fit: cover;" loading="lazy"/></p>
                                <p class="font-weight-bold">Điều trị da</p>
                            </div>
                            <div class="col-6 col-lg-3 o_colored_level">
                                <p class="h1-fs" style="color: #1a202c;">04</p>
                                <!-- Ảnh Dịch Vụ 04 -->
                                <p><img src="/ht_beauty_website/static/img/service_04.jpg" alt="Triệt lông" class="img img-fluid rounded" style="width: 100%; aspect-ratio: 1/1; object-fit: cover;" loading="lazy"/></p>
                                <p class="font-weight-bold">Triệt lông vĩnh viễn</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Section 4: Con số -->
                <section class="s_numbers o_cc o_colored_level o_cc1 bg-white pt48 pb40" data-snippet="s_numbers">
                    <div class="container">
                        <div class="row align-items-center s_nb_column_fixed">
                            <div class="o_colored_level col-lg-5">
                                <h2 class="mb-3 h4-fs">Niềm Tự Hào Của Chúng Tôi</h2>
                                <p class="lead">Sự hài lòng và gắn bó của khách hàng chính là thước đo thành công chân thực nhất.</p>
                            </div>
                            <div class="o_colored_level col-lg-4 text-center">
                                <span class="s_number display-1-fs" style="color: rgb(18, 115, 119);">10.000+</span><br/> 
                                <span class="h5-fs">Khách hàng hài lòng</span>
                            </div>
                            <div class="o_colored_level col-lg-3 text-center">
                                <span class="s_number display-1-fs" style="color: rgb(18, 115, 119);">100%</span><br/> 
                                <span class="h5-fs">Sản phẩm chính hãng</span>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

    <!-- ============================================== -->
    <!-- 2. TRANG DỊCH VỤ                               -->
    <!-- ============================================== -->
    <template id="services_template" name="HT Beauty - Dịch Vụ">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure"/>
                <section class="pt48 pb64">
                    <div class="container">
                        <t t-foreach="categories" t-as="cat">
                            <div class="mb-5">
                                <h3 class="border-bottom pb-2 mb-4"><t t-esc="cat.name"/></h3>
                                <div class="row">
                                    <t t-foreach="services.filtered(lambda s: s.categ_id.id == cat.id)" t-as="srv">
                                        <div class="col-lg-4 col-md-6 mb-4">
                                            <div class="card h-100 shadow-sm border-0">
                                                <!-- Odoo sẽ lấy ảnh của sản phẩm nếu có, nếu không sẽ lấy ảnh mặc định dưới đây -->
                                                <t t-if="srv.image_512">
                                                    <span t-field="srv.image_512" t-options="{'widget': 'image', 'class': 'card-img-top', 'style': 'height: 250px; object-fit: cover;'}"/>
                                                </t>
                                                <t t-else="">
                                                    <div class="bg-200 d-flex align-items-center justify-content-center" style="height: 250px;">
                                                        <!-- Ảnh mặc định dịch vụ -->
                                                        <img src="/ht_beauty_website/static/img/service_default.jpg" alt="Dịch vụ" class="img img-fluid" style="width: 100%; height: 100%; object-fit: cover;"/>
                                                    </div>
                                                </t>
                                                <div class="card-body d-flex flex-column text-center">
                                                    <h5 class="card-title font-weight-bold mb-3"><t t-esc="srv.name"/></h5>
                                                    <div class="mt-auto">
                                                        <a t-attf-href="/lien-he?service_id={{ srv.id }}" class="btn btn-outline-primary w-100 rounded-pill">
                                                            Đăng Ký Tư Vấn
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </section>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <!-- ============================================== -->
    <!-- 3. TRANG LIÊN HỆ                               -->
    <!-- ============================================== -->
    <template id="contact_us_template" name="HT Beauty - Liên Hệ">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure"/>
                <section class="pt48 pb64" style="background-color: #fafafa;">
                    <div class="container">
                        <div class="row align-items-center">
                            
                            <!-- Cột Trái -->
                            <div class="col-lg-5 mb-5 pe-lg-5 o_colored_level">
                                <!-- Ảnh Logo Cty -->
                                <img src="/ht_beauty_website/static/img/ht_logo.png" alt="HT Beauty Logo" class="img img-fluid mb-4" style="max-height: 120px;"/>
                                <h3 class="font-weight-bold mb-3" style="color: #333;">CÔNG TY TNHH TM DV TRƯƠNG HOÀNG THI</h3>
                                <p class="lead text-muted mb-4" style="font-size: 16px;">Viện Thẩm Mỹ HT - Nơi đánh thức và thăng hoa nhan sắc.</p>
                                <ul class="list-unstyled" style="line-height: 2.5; color: #555;">
                                    <li><i class="fa fa-map-marker me-3" style="color: #bfa15f;"/> <b>Địa chỉ:</b> 88 Đường 3/2, P12, Q.10, TP.HCM</li>
                                    <li><i class="fa fa-phone me-3" style="color: #bfa15f;"/> <b>Hotline:</b> 0932 94 78 79 - 0708 94 78 79</li>
                                    <li><i class="fa fa-clock-o me-3" style="color: #bfa15f;"/> <b>Thời gian:</b> 08:00 - 20:00 (Thứ 2 - Chủ nhật)</li>
                                </ul>
                            </div>
                            
                            <!-- Cột Phải (Form) -->
                            <div class="col-lg-7">
                                <div class="card shadow-lg border-0 rounded-3">
                                    <div class="card-body p-4 p-md-5">
                                        <h4 class="mb-4 text-center font-weight-bold" style="color: #333;">Để Lại Thông Tin Tư Vấn</h4>
                                        <form action="/lien-he/submit" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Họ và tên *</label>
                                                <input type="text" class="form-control" name="contact_name" required="1" style="border: 1px solid #e0e0e0;"/>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label fw-bold">Số điện thoại *</label>
                                                    <input type="tel" class="form-control" name="phone" required="1" style="border: 1px solid #e0e0e0;"/>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label fw-bold">Link Zalo (Nếu có)</label>
                                                    <input type="url" class="form-control" name="zalo_link" style="border: 1px solid #e0e0e0;"/>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Dịch vụ quan tâm</label>
                                                <select class="form-select" name="service_id" style="border: 1px solid #e0e0e0;">
                                                    <option value="">- Chọn dịch vụ -</option>
                                                    <t t-foreach="services" t-as="srv">
                                                        <option t-att-value="srv.id" t-att-selected="srv.id == selected_service_id">
                                                            <t t-esc="srv.name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                            </div>
                                            <div class="mb-4">
                                                <label class="form-label fw-bold">Tình trạng da</label>
                                                <textarea class="form-control" name="description" rows="3" style="border: 1px solid #e0e0e0;"/>
                                            </div>
                                            <div class="d-grid">
                                                <button type="submit" class="btn btn-lg rounded-pill font-weight-bold" style="background-color: #d0c4f5; color: #1a202c; border: none;">
                                                    TƯ VẤN MIỄN PHÍ
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <!-- ============================================== -->
    <!-- 4. TRANG CẢM ƠN                                -->
    <!-- ============================================== -->
    <template id="contact_success_template" name="Gửi Thành Công">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container pt-5 pb-5 text-center my-5">
                    <i class="fa fa-check-circle" style="font-size: 80px; color: #d0c4f5;"/>
                    <h2 class="mt-4 font-weight-bold">Cảm ơn bạn đã quan tâm!</h2>
                    <p class="lead text-muted">Chuyên viên của HT Beauty sẽ sớm liên hệ để tư vấn cho bạn.</p>
                    <a href="/" class="btn rounded-pill px-4 mt-3 font-weight-bold" style="background-color: #d0c4f5; color: #1a202c;">
                        Về Trang Chủ
                    </a>
                </div>
            </div>
        </t>
    </template>
<!-- ============================================== -->
    <!-- 5. TÙY CHỈNH HEADER & FOOTER   -->
    <!-- ============================================== -->
    <template id="ht_beauty_header_footer" inherit_id="website.layout" name="HT Beauty Global Layout">
        
        <xpath expr="//header" position="replace">
            <header id="top" style="background-color: #127377 !important; border-bottom: none;">
                <nav class="navbar navbar-expand-lg navbar-dark container py-3">
                    
                    <!-- 1. Logo cứng -->
                    <a href="/" class="navbar-brand logo me-4">
                        <img src="/ht_beauty_website/static/img/ht_logo.png" alt="HT Beauty" style="max-height: 55px;"/>
                    </a>
                    
                    <!-- Nút mở menu trên Mobile -->
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#ht_top_menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    
                    <div class="collapse navbar-collapse" id="ht_top_menu">
                        <!-- 2. Cụm Menu bên trái -->
                        <ul class="navbar-nav me-auto fw-bold" style="font-size: 16px;">
                            <li class="nav-item"><a href="/" class="nav-link text-white px-3">Trang chủ</a></li>
                            <li class="nav-item"><a href="/dich-vu" class="nav-link text-white px-3">Dịch Vụ</a></li>
                            <li class="nav-item"><a href="/lien-he" class="nav-link text-white px-3">Liên Hệ</a></li>
                        </ul>
                        
                        <!-- 3. Cụm công cụ và Nút bấm bên phải -->
                        <ul class="navbar-nav align-items-center gap-3">
                            <!-- Nút Tìm kiếm -->
                            <li class="nav-item">
                                <a href="#" class="nav-link text-white rounded-circle d-flex align-items-center justify-content-center" style="background-color: rgba(255,255,255,0.1); width: 38px; height: 38px;">
                                    <i class="fa fa-search"/>
                                </a>
                            </li>
                            <!-- Nút Ngôn ngữ -->
                            <li class="nav-item dropdown">
                                <a href="#" class="nav-link dropdown-toggle text-white" data-bs-toggle="dropdown">English (US)</a>
                            </li>
                            <!-- Tên Admin (chỉ hiện khi đã đăng nhập) -->
                            <t t-if="not user_id._is_public()">
                                <li class="nav-item dropdown">
                                    <a href="#" class="nav-link dropdown-toggle text-white" data-bs-toggle="dropdown">Administrator</a>
                                </li>
                            </t>
                            <!-- Nút Tư vấn miễn phí cứng -->
                            <li class="nav-item ms-2">
                                <a href="/lien-he" class="btn fw-bold px-4 py-2 rounded-1" style="background-color: #d0c4f5; color: #1a202c; font-size: 14px;">
                                    Tư vấn miễn phí
                                </a>
                            </li>
                        </ul>
                    </div>
                </nav>
            </header>
        </xpath>

        <!-- FOOTER -->
        <xpath expr="//footer" position="replace">
            <footer id="bottom" style="background-color: #127377; color: #ffffff;">
                <div class="container pt64 pb64">
                    <div class="row">
                        <!-- Cột 1: Liên kết -->
                        <div class="col-lg-3 mb-4">
                            <h4 class="fw-bold mb-4" style="font-family: serif; font-size: 22px;">Liên kết</h4>
                            <ul class="list-unstyled" style="line-height: 2.2;">
                                <li><a href="/" class="text-white text-decoration-none">Trang chủ</a></li>
                                <li><a href="/dich-vu" class="text-white text-decoration-none">Dịch vụ</a></li>
                                <li><a href="/lien-he" class="text-white text-decoration-none">Đặt lịch hẹn</a></li>
                                <li><a href="/lien-he" class="text-white text-decoration-none">Chính sách</a></li>
                                <li><a href="/lien-he" class="text-white text-decoration-none">Liên hệ</a></li>
                            </ul>
                        </div>

                        <!-- Cột 2: Về chúng tôi -->
                        <div class="col-lg-5 mb-4 pe-lg-5">
                            <h4 class="fw-bold mb-4" style="font-family: serif; font-size: 22px;">Về chúng tôi</h4>
                            <p style="line-height: 1.8; font-size: 15px;">
                                Tự hào là điểm đến làm đẹp uy tín tại trung tâm TP. HCM. Chúng tôi đồng hành cùng bạn trên hành trình duy trì và thăng hoa nhan sắc bằng các công nghệ thẩm mỹ tiên tiến và an toàn nhất.
                            </p>
                        </div>

                        <!-- Cột 3: Kết nối với chúng tôi -->
                        <div class="col-lg-4 mb-4">
                            <h4 class="fw-bold mb-4" style="font-family: serif; font-size: 22px;">Kết nối với chúng tôi</h4>
                            <ul class="list-unstyled" style="line-height: 2; font-size: 15px;">
                                <li class="mb-2"><i class="fa fa-envelope me-2"/> contact@vienthammyht.vn</li>
                                <li><i class="fa fa-phone me-2"/> 0708 94 78 79</li>
                            </ul>
                            <div class="mt-4">
                                <a href="#" class="btn btn-light rounded-circle me-2 d-inline-flex justify-content-center align-items-center" style="width: 36px; height: 36px;"><i class="fa fa-facebook text-dark"/></a>
                                <a href="#" class="btn btn-light rounded-circle me-2 d-inline-flex justify-content-center align-items-center" style="width: 36px; height: 36px;"><i class="fa fa-twitter text-dark"/></a>
                                <a href="#" class="btn btn-light rounded-circle me-2 d-inline-flex justify-content-center align-items-center" style="width: 36px; height: 36px;"><i class="fa fa-linkedin text-dark"/></a>
                                <a href="#" class="btn btn-light rounded-circle d-inline-flex justify-content-center align-items-center" style="width: 36px; height: 36px;"><i class="fa fa-home text-dark"/></a>
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
        </xpath>
        
    </template>
</odoo>